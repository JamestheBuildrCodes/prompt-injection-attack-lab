# Copy to .env and edit. Never commit .env.
# The app works with no configuration at all (mock target, no API calls).

# Optional: defaults pre-filled in the "External target" form.
# The API key is only read from the environment or typed into the form at run time.
# It is never written to the database, reports or logs.
PIAL_API_BASE_URL=https://api.openai.com/v1
PIAL_API_MODEL=gpt-4o-mini
PIAL_API_KEY=

# Optional tuning
PIAL_DB_PATH=data/pial.db
PIAL_MAX_UPLOAD_MB=5
PIAL_REQUEST_TIMEOUT=30
PIAL_REQUEST_DELAY=0.5
